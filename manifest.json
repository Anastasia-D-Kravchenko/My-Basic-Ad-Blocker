{
  "manifest_version": 3,
  "name": "My Basic Ad Blocker",
  "version": "1.0",
  "description": "A simple Chrome extension that blocks specific ad domains.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Blocker Controls"
  }
}